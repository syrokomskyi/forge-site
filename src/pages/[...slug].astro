import { getRouteRegistry, getStaticPathsForDefaultLang } from "@warpgogol/werkstatt-site/share/astro/routes";
import { resolvePageRoute } from "@warpgogol/werkstatt-site/share/astro/page-handler";
import { extractSectionNavItems } from "@warpgogol/werkstatt-site/share/astro/section-nav-items";
import { loadAgentSurfaceManifest, createBuildSemanticModel } from "@warpgogol/werkstatt-site/share/astro/page-renderer-utils";
import PageRenderer from "@warpgogol/werkstatt-site/ui/components/page-renderer";
import "@styles/global.css";
import globalStylesheetUrl from "@styles/global.css?url";

export async function getStaticPaths() {
  // RFC-0160: unprefixed default-language pages only (home excluded — owned by index.astro).
  return getStaticPathsForDefaultLang();
}

const { defaultLanguage } = await getRouteRegistry();
const lang = defaultLanguage;
const { slug } = Astro.params;
const data = await resolvePageRoute({
  lang,
  slug: slug ?? "",
  siteUrl: Astro.site?.toString() ?? Astro.url.origin,
  buildSemanticModel: createBuildSemanticModel(`${process.cwd()}/src/content/business-profile`),
});

// RFC-0192: Programmatic Surface redirect stub — 301 to the live ancestor.
if (data.redirectTo) {
  return Astro.redirect(data.redirectTo, 301);
}

// RFC-0922: extract section nav items when the page has sectionNav enabled.
const sectionNavItems = data.sectionNav ? extractSectionNavItems(data.page.blocks) : [];
---

<PageRenderer
  data={data}
  lang={lang}
  sectionNavItems={sectionNavItems}
  agentSurfaceManifest={loadAgentSurfaceManifest()}
  globalStylesheetUrl={globalStylesheetUrl}
  showCanonical={true}
/>
