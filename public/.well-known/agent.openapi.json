          "tookMs"
        ],
        "properties": {
          "query": {
            "type": "string"
          },
          "results": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "title",
                "canonicalUrl",
                "updatedAt",
                "lang",
                "type",
                "score",
                "text"
              ],
              "properties": {
                "title": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "canonicalUrl": {
                  "type": "string"
                },
                "updatedAt": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "lang": {
                  "type": "string"
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "page",
                    "knowledge",
                    "faq",
                    "prose"
                  ]
                },
                "score": {
                  "type": "number"
                },
                "text": {
                  "type": "string"
                }
              }
            }
          },
          "tookMs": {
            "type": "number"
          }
