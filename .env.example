# forge.warpgogol.com — runtime & build secrets. Copy to .env and fill the keys you need.
# Every key is OPTIONAL: a section degrades gracefully when its
# key is absent (the send-message form falls back to a mailto link). sites-check prints a gentle
# notice (integration.secrets.audit) listing live vs dormant channels — it never blocks a build.
#
# Never commit .env. The values here MUST stay empty (env.example.validate enforces it).
# Every key includes a "# How to obtain:" line with concrete instructions (RFC-0388).

# ── Lagebild API ingress (optional). When all four keys are set, contact forms
# also submit to the Lagebild API POST /v1/ingress (WebsiteIngress v1).
# LAGEBILD_API_URL: base URL of the Lagebild API Worker.
# LAGEBILD_API_KEY: service principal Bearer token.
# LAGEBILD_TENANT_ID: tenant ID (ten_<16+ chars>).
# LAGEBILD_SOURCE_SYSTEM_ID: source system ID for this site (site_<8+ chars>).
# How to obtain: Lagebild API base URL (e.g. https://lagebild-api.example.workers.dev).
LAGEBILD_API_URL=

# How to obtain: Service principal API key for Lagebild API (Bearer token).
LAGEBILD_API_KEY=

# How to obtain: Tenant ID in Lagebild (format: ten_<16+ chars>).
LAGEBILD_TENANT_ID=

# How to obtain: Source system ID for this site (format: site_<8+ chars>).
LAGEBILD_SOURCE_SYSTEM_ID=

# ── QStash — Queue as a Service by Upstash (RFC-0181). EU region only (UPSTASH_QSTASH_URL must be https://qstash-eu-central-1.upstash.io). Reliable lead
# delivery (retries + DLQ + dedup); signing keys verify the inbound webhook.
# How to obtain: Upstash Console → QStash → EU Region → Overview → Quickstart → QSTASH_URL.
UPSTASH_QSTASH_URL=

# How to obtain: Upstash Console → QStash → COPY/DELETE tokens section.
UPSTASH_QSTASH_TOKEN=

# How to obtain: Upstash Console → QStash → Settings → Current signing key.
UPSTASH_QSTASH_CURRENT_SIGNING_KEY=

# How to obtain: Upstash Console → QStash → Settings → Next signing key.
UPSTASH_QSTASH_NEXT_SIGNING_KEY=

# ── Redis — Key-Value store by Upstash (RFC-0181). EU region only (the REST URL must be the
# eu-central-1 endpoint). Durable idempotency ledger (SET NX on eventId) — holds no PII.
# How to obtain: Upstash Console → Redis → eu-central-1 → REST API section.
UPSTASH_REDIS_REST_URL=

# How to obtain: Upstash Console → Redis → eu-central-1 → REST API section.
UPSTASH_REDIS_REST_TOKEN=

# ── Cloudflare API credentials. CLOUDFLARE_API_TOKEN is required for dns.record.upsert
# (Zone:DNS:Edit) and agent.search operations. CLOUDFLARE_READONLY_API_TOKEN is used
# for Regional Services validation (RFC-0182) — optional, only when system.md declares
# non-empty deployment.cloudflare.regionalServices.allowedZones.
#
# TOKEN CREATION (Cloudflare Dashboard → My Profile → API Tokens):
#   CLOUDFLARE_API_TOKEN: Create Custom Token with Zone:DNS:Edit, Zone:Cache Purge,
#     Account:Workers Scripts:Edit, Zone:Workers Routes:Edit, Zone:Page Rules:Edit.
#     Scope to specific account and zone only.
#   CLOUDFLARE_READONLY_API_TOKEN: Create Custom Token named "Regional Services Read-only"
#     with Zone:Read permission. Scope to specific zone.
#
# ACCOUNT_ID & ZONE_ID: Cloudflare Dashboard → Overview → API section (right sidebar).
#   Account ID is at the top; Zone ID is below it for the selected domain.
# Prefer CLOUDFLARE_READONLY_API_TOKEN for read-only operations (least-privilege).
# How to obtain: Cloudflare Dashboard → My Profile → API Tokens → Create Custom Token (User API Token, NOT Account API Token). Required permissions: Zone → Cache Purge → Purge, Account → Workers Scripts → Edit, Zone → Workers Routes → Edit, Zone → DNS → Edit (for subdomain.register), Zone → Page Rules → Edit (for cache bypass setup). Scope to specific account and zone only. See docs/engineering/workshop-setup.md for full guide.
CLOUDFLARE_API_TOKEN=

# How to obtain: Cloudflare Dashboard → My Profile → API Tokens → Create Custom Token with Zone:Read.
CLOUDFLARE_READONLY_API_TOKEN=

# How to obtain: Cloudflare Dashboard → Domains Overview → click any domain → right-hand sidebar → API section → Zone ID.
CLOUDFLARE_ZONE_ID=

# ── Agent Semantic Search (RFC-0954). Optional — only required when agent semantic search
# is enabled (search-manifest.json present). The reindex token protects the POST
# /api/agent/search/reindex endpoint from unauthorized index rebuilds.
# CLOUDFLARE_API_TOKEN and CLOUDFLARE_ACCOUNT_ID are used by agent.search.index.create
# and agent.search.warm (CLI-side, not runtime).
# How to obtain: Generate a random secret: openssl rand -hex 32. Protects the POST /api/agent/search/reindex endpoint. Required when agent semantic search is enabled.
SEARCH_REINDEX_TOKEN=

# ── Responsive image variants (RFC-0204). Build-portable emits real srcset from
# pre-generated static width variants; no Cloudflare Image Transformations required.
# Default is "build-portable"; set empty to fall back to raw origin assets.
# How to obtain: Set to "build-portable" to enable; leave empty for raw origin assets.
PUBLIC_IMAGE_PROVIDER=build-portable
