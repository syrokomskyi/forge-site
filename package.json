  "scripts": {
    "start": "pnpm run stop; astro dev",
    "stop": "astro dev stop",
    "build:check": "werkstatt pipeline build.prepare --site forge-site && werkstatt pipeline build.check --site forge-site && pnpm -s astro:check && astro build && werkstatt pipeline build.post --site forge-site",
    "build": "werkstatt pipeline build.prepare --site forge-site && pnpm -s astro:check && astro build && werkstatt pipeline build.post --site forge-site",
    "build:deploy:alt": "pnpm run build && pnpm run deploy:alt",
    "deploy:alt": "werkstatt run deploy.preflight --site forge-site && wrangler deploy --name alt-forge-site --secrets-file .env",
    "build:deploy:main": "pnpm run build && pnpm run deploy:main",
    "deploy:main": "werkstatt run deploy.preflight --site forge-site && wrangler deploy --name forge-site --secrets-file .env",
    "preview": "wrangler dev",
    "astro": "astro",
    "astro:check": "astro check",
    "site-os:apps": "werkstatt apps list",
    "changelog:generate": "werkstatt run changelog.generate --site forge-site",
    "changelog:generate:force": "werkstatt run changelog.generate --site forge-site -- --force",
    "changelog:dry-run": "werkstatt run changelog.generate --site forge-site -- --dry-run --force",
    "changelog:rebuild-index": "werkstatt run changelog.rebuild-index --site forge-site",
    "changelog:backfill": "werkstatt run changelog.backfill --site forge-site",
    "icons:gen": "werkstatt run icons.generate --site forge-site",
    "icons:clean": "werkstatt run icons.clean --site forge-site",
    "i18n:middleware:gen": "werkstatt run i18n.middleware.generate --site forge-site",
    "open-source:gen": "werkstatt run open-source.generate --site forge-site",
    "check": "werkstatt pipeline check --site forge-site",
    "tokens:ds:lint": "werkstatt run tokens.ds.lint --site forge-site",
    "tokens:colors:lint": "werkstatt run tokens.colors.lint --site forge-site",
    "content:validate": "werkstatt run content.validate --site forge-site",
    "compass:inventory": "werkstatt run compass.inventory --site forge-site",
    "compass:validate": "werkstatt run compass.validate --site forge-site",
    "thin-copy:validate": "werkstatt run thin-copy.validate --site forge-site",
    "integrity:init": "werkstatt run integrity.init --site forge-site",
    "integrity:update": "werkstatt run integrity.update --site forge-site",
    "integrity:verify": "werkstatt run integrity.verify --site forge-site",
    "integrity:build-record": "werkstatt run integrity.build-record --site forge-site",
    "integrity:sign": "werkstatt run integrity.sign --site forge-site",
    "integrity:verify-release": "werkstatt run integrity.verify-release --site forge-site",
    "integrity:keys:generate": "werkstatt run integrity.keys.generate --site forge-site",
    "integrity:release": "werkstatt pipeline integrity.release --site forge-site",
    "integrity:backfill-revisions": "werkstatt run integrity.backfill-revisions --site forge-site",
    "upgrade-packages": "pnpm up --latest"
  },
  "gogol": {
    "testSignal": {
      "signal": "skipped",
      "owner": "architecture",
      "rationale": "App author/build checks currently cover the deployable site; direct app unit tests are deferred until an app-level smoke-test harness lands.",
