{
  "_": "GENERATED. Do not change this line unless the file contains project specific changes.",
  "name": "forge-site",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.8.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
